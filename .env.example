# MongoDB Atlas connection string (free tier is fine)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/boxbol?retryWrites=true&w=majority

# Groq (https://console.groq.com/keys). Check the current Llama model name on Groq's models page.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional offline fallback: set LLM_PROVIDER=ollama and run Llama locally
LLM_PROVIDER=groq
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Login: the passcode your father types once per device, and a long random secret
# that signs the login cookie (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
APP_PASSCODE=
SESSION_SECRET=

# Public URL of the deployed app, used in the WhatsApp text fallback link
PUBLIC_BASE_URL=http://localhost:3000
