# MongoDB Atlas connection string (free tier is fine)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/boxbol?retryWrites=true&w=majority

# Groq (https://console.groq.com/keys). Groq no longer serves Llama chat models; gpt-oss-120b is the open-weight model used instead.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Used when the main model hits Groq's limits or is down (each model has its own daily limit). "none" turns it off.
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# How much the model thinks before answering. low is enough to read a request, and uses far fewer tokens.
GROQ_REASONING_EFFORT=low

# Optional offline fallback: set LLM_PROVIDER=ollama and run Llama locally
LLM_PROVIDER=groq
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Login: the passcode your father types once per device, and a long random secret
# that signs the login cookie (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
APP_PASSCODE=
SESSION_SECRET=

# Public URL of the deployed app, used in the WhatsApp text fallback link
PUBLIC_BASE_URL=http://localhost:3000
